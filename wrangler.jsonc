{
	"compatibility_date": "2025-10-08",
	"main": "src/index.ts",
	"name": "qr-container",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "d1-qr-container",
			"database_id": "2a2dcd5e-1e18-45d5-b87e-c97a98c1e4b2"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "f4f3cad3d9564da59629cbb1a8617363"
		}
	],
	"r2_buckets": [
		{
			"binding": "LOGOS",
			"bucket_name": "qr-container-logos"
		}
	],
	"vars": {
		"LOGOS_BASE_URL": "https://pub-e8b23ca60a9041249e50e50e3ebd4fca.r2.dev"
	},
	"triggers": {
		"crons": ["0 0 * * 1"]
	}
}
